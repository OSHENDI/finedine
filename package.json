{
  "name": "finedine",
  "version": "0.1.0",
  "private": true,
  "engines": { "node": ">=20.9" },
  "browserslist": ["chrome >= 100", "edge >= 100", "firefox >= 100", "safari >= 15.4", "ios_saf >= 15.4", "samsung >= 18"],
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "local": "node scripts/local.mjs",
    "build": "next build",
    "prestart": "node --env-file-if-exists=.env scripts/migrate.mjs",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:reset": "node scripts/reset-db.mjs",
    "test:integration": "tsx scripts/integration.ts && tsx scripts/migrations-test.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=.env scripts/migrate.mjs",
    "test:postgres": "tsx scripts/postgres-test.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.9",
    "bcryptjs": "3.0.2",
    "drizzle-orm": "0.45.4",
    "jose": "6.1.0",
    "next": "16.4.0",
    "postgres": "3.4.9",
    "qrcode": "1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "24.7.2",
    "@types/qrcode": "1.5.5",
    "@types/react": "19.1.16",
    "@types/react-dom": "19.1.9",
    "drizzle-kit": "0.31.11",
    "eslint": "9.37.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2"
  },
  "overrides": {
    "esbuild": "0.28.2"
  }
}
