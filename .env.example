# Leave DATABASE_URL unset for zero-config local PGlite in ./.pgdata (development only).
# Production REQUIRES a real PostgreSQL URL, for example:
# DATABASE_URL="postgresql://user:password@host:5432/finedine"
# With Postgres, run "npm run db:migrate" after pulling changes ("npm start" and the Docker image do it for you).
# Live updates and rate limits are shared through Postgres, so several app instances can run.
PGLITE_DATA_DIR="./.pgdata"

# Required in production: 32+ random characters (for example: openssl rand -base64 48).
AUTH_SECRET="replace-with-a-long-random-secret-before-production"
# Optional separate secret for QR tokens. Changing it invalidates printed QR codes.
# QR_TOKEN_SECRET=""

# Public address of the site (used in QR codes). Only for a custom domain: on Render, RENDER_EXTERNAL_URL is used.
# APP_URL="https://menu.example.com"

# Orders allowed per minute from one address (default 12). Raise it when many customers share one address.
# ORDER_RATE_LIMIT=120

# Production only: creates the first owner when the database is empty. Remove after first login.
# ADMIN_EMAIL="you@example.com"
# ADMIN_PASSWORD="at-least-12-characters"

# Number of trusted reverse proxies in front of the app (used for client IP rate limiting).
# Use 0 when the app is exposed directly.
TRUST_PROXY_HOPS=1

# Menu photos and receipts are stored in the database: no upload folder or volume is needed.

# Escape hatch: allow embedded PGlite in production (single process demos only).
# ALLOW_PGLITE=true
